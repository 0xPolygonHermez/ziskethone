diff -urN qa/gcc/config/riscv/riscv.cc qb/gcc/config/riscv/riscv.cc
--- qa/gcc/config/riscv/riscv.cc	2026-08-09 00:45:07.747871624 +0200
+++ qb/gcc/config/riscv/riscv.cc	2026-08-09 00:45:07.757189990 +0200
@@ -8606,6 +8606,28 @@
   return 0;
 }
 
+/* ZisK indirect-operand measurement harness.
+
+   True if X is an address the proposed ZisK indirect ALU operand could carry.
+   A bare register always; a register plus displacement only in variant 2 and
+   only for a source, which is what keeps the two variants comparable: every
+   other decision is identical, so any difference in how many operands fold is
+   attributable to the displacement alone.  */
+
+bool
+riscv_zisk_ind_addr_p (rtx x, bool is_src)
+{
+  if (riscv_zisk_memops == 0)
+    return false;
+  if (REG_P (x))
+    return true;
+  return (riscv_zisk_memops >= 2 && is_src
+	  && GET_CODE (x) == PLUS
+	  && REG_P (XEXP (x, 0))
+	  && CONST_INT_P (XEXP (x, 1))
+	  && SMALL_OPERAND (INTVAL (XEXP (x, 1))));
+}
+
 /* Implement TARGET_MEMORY_MOVE_COST.  */
 
 static int
diff -urN qa/gcc/config/riscv/riscv.md qb/gcc/config/riscv/riscv.md
--- qa/gcc/config/riscv/riscv.md	2026-08-09 00:45:07.749301313 +0200
+++ qb/gcc/config/riscv/riscv.md	2026-08-09 00:45:07.757429085 +0200
@@ -3949,3 +3949,127 @@
 (include "zc.md")
 (include "corev.md")
 (include "xiangshan.md")
+
+;; ---------------------------------------------------------------------------
+;; ZisK indirect-operand measurement harness (-mzisk-memops=N)
+;;
+;; These patterns exist to find out how many load/ALU and ALU/store pairs
+;; `combine` would actually fold if a ZisK instruction could take an indirect
+;; operand, and how much of that depends on the address carrying a
+;; displacement.  They do NOT emit a fused instruction: each one expands to
+;; exactly the instructions the unfused code would have used, with the loaded
+;; value pinned in t6 (and t5 when two operands are indirect).  Build with
+;; -ffixed-t6 -ffixed-t5 and every `ld t6,...` in the output is a site combine
+;; folded, so the sites can be counted and weighted by a real execution
+;; histogram while the binary still runs and still hashes correctly.
+;; ---------------------------------------------------------------------------
+
+(define_code_iterator zisk_alu [plus minus and ior xor])
+(define_code_iterator zisk_sh [ashift ashiftrt lshiftrt])
+(define_mode_iterator ZKSUB [QI HI (SI "TARGET_64BIT")])
+(define_mode_attr zkload [(QI "lbu") (HI "lhu") (SI "lwu")])
+
+;; reg = reg OP [mem]
+(define_insn "*zisk_alu_rrm_<optab><mode>"
+  [(set (match_operand:X 0 "register_operand" "=r")
+	(zisk_alu:X (match_operand:X 1 "register_operand" "r")
+		    (match_operand:X 2 "zisk_ind_src_operand" "ZkS")))
+   (clobber (reg:X 31))]
+  "riscv_zisk_memops"
+  "<load>\tt6,%2\;<insn>\t%0,%1,t6"
+  [(set_attr "type" "multi") (set_attr "length" "8")])
+
+;; reg = [mem] OP reg
+(define_insn "*zisk_alu_rmr_<optab><mode>"
+  [(set (match_operand:X 0 "register_operand" "=r")
+	(zisk_alu:X (match_operand:X 1 "zisk_ind_src_operand" "ZkS")
+		    (match_operand:X 2 "register_operand" "r")))
+   (clobber (reg:X 31))]
+  "riscv_zisk_memops"
+  "<load>\tt6,%1\;<insn>\t%0,t6,%2"
+  [(set_attr "type" "multi") (set_attr "length" "8")])
+
+;; reg = [mem] OP imm
+(define_insn "*zisk_alu_rmi_<optab><mode>"
+  [(set (match_operand:X 0 "register_operand" "=r")
+	(zisk_alu:X (match_operand:X 1 "zisk_ind_src_operand" "ZkS")
+		    (match_operand:X 2 "const_arith_operand" "I")))
+   (clobber (reg:X 31))]
+  "riscv_zisk_memops"
+  "<load>\tt6,%1\;<insn>%i2\t%0,t6,%2"
+  [(set_attr "type" "multi") (set_attr "length" "8")])
+
+;; [mem] = reg OP reg
+(define_insn "*zisk_alu_mrr_<optab><mode>"
+  [(set (match_operand:X 0 "zisk_ind_dst_operand" "=ZkD")
+	(zisk_alu:X (match_operand:X 1 "register_operand" "r")
+		    (match_operand:X 2 "register_operand" "r")))
+   (clobber (reg:X 31))]
+  "riscv_zisk_memops"
+  "<insn>\tt6,%1,%2\;<store>\tt6,%0"
+  [(set_attr "type" "multi") (set_attr "length" "8")])
+
+;; reg = [mem] OP [mem]
+(define_insn "*zisk_alu_rmm_<optab><mode>"
+  [(set (match_operand:X 0 "register_operand" "=r")
+	(zisk_alu:X (match_operand:X 1 "zisk_ind_src_operand" "ZkS")
+		    (match_operand:X 2 "zisk_ind_src_operand" "ZkS")))
+   (clobber (reg:X 31))
+   (clobber (reg:X 30))]
+  "riscv_zisk_memops"
+  "<load>\tt6,%1\;<load>\tt5,%2\;<insn>\t%0,t6,t5"
+  [(set_attr "type" "multi") (set_attr "length" "12")])
+
+;; reg = reg OP zero_extend([mem])   -- narrow loads feeding an ALU op
+(define_insn "*zisk_zx_rrm_<optab><mode>"
+  [(set (match_operand:X 0 "register_operand" "=r")
+	(zisk_alu:X (match_operand:X 1 "register_operand" "r")
+		    (zero_extend:X
+		      (match_operand:ZKSUB 2 "zisk_ind_src_operand" "ZkS"))))
+   (clobber (reg:X 31))]
+  "riscv_zisk_memops"
+  "<ZKSUB:zkload>\tt6,%2\;<insn>\t%0,%1,t6"
+  [(set_attr "type" "multi") (set_attr "length" "8")])
+
+;; reg = zero_extend([mem]) OP reg
+(define_insn "*zisk_zx_rmr_<optab><mode>"
+  [(set (match_operand:X 0 "register_operand" "=r")
+	(zisk_alu:X (zero_extend:X
+		      (match_operand:ZKSUB 1 "zisk_ind_src_operand" "ZkS"))
+		    (match_operand:X 2 "register_operand" "r")))
+   (clobber (reg:X 31))]
+  "riscv_zisk_memops"
+  "<ZKSUB:zkload>\tt6,%1\;<insn>\t%0,t6,%2"
+  [(set_attr "type" "multi") (set_attr "length" "8")])
+
+;; reg = zero_extend([mem]) OP imm
+(define_insn "*zisk_zx_rmi_<optab><mode>"
+  [(set (match_operand:X 0 "register_operand" "=r")
+	(zisk_alu:X (zero_extend:X
+		      (match_operand:ZKSUB 1 "zisk_ind_src_operand" "ZkS"))
+		    (match_operand:X 2 "const_arith_operand" "I")))
+   (clobber (reg:X 31))]
+  "riscv_zisk_memops"
+  "<ZKSUB:zkload>\tt6,%1\;<insn>%i2\t%0,t6,%2"
+  [(set_attr "type" "multi") (set_attr "length" "8")])
+
+;; reg = [mem] SHIFT count
+(define_insn "*zisk_sh_rm_<optab><mode>"
+  [(set (match_operand:X 0 "register_operand" "=r")
+	(zisk_sh:X (match_operand:X 1 "zisk_ind_src_operand" "ZkS")
+		   (match_operand:QI 2 "arith_operand" "rI")))
+   (clobber (reg:X 31))]
+  "riscv_zisk_memops"
+  "<load>\tt6,%1\;<insn>%i2\t%0,t6,%2"
+  [(set_attr "type" "multi") (set_attr "length" "8")])
+
+;; reg = zero_extend([mem]) SHIFT count   -- this is the lbu+slli shape
+(define_insn "*zisk_zxsh_rm_<optab><mode>"
+  [(set (match_operand:X 0 "register_operand" "=r")
+	(zisk_sh:X (zero_extend:X
+		     (match_operand:ZKSUB 1 "zisk_ind_src_operand" "ZkS"))
+		   (match_operand:QI 2 "arith_operand" "rI")))
+   (clobber (reg:X 31))]
+  "riscv_zisk_memops"
+  "<ZKSUB:zkload>\tt6,%1\;<insn>%i2\t%0,t6,%2"
+  [(set_attr "type" "multi") (set_attr "length" "8")])
