index d76e8f8..48cb079 100644
--- a/lib/evmone/baseline_analysis.cpp
+++ b/lib/evmone/baseline_analysis.cpp
@@ -110,10 +110,50 @@ CodeAnalysis analyze_legacy(bytes_view code)
 
