 }
+
+// analyze_legacy(), but with `storage` carved from a caller-provided buffer
+// instead of make_unique — for the ZisK analysis cache's fixed arena. See
+// baseline.hpp. Never destroy the returned CodeAnalysis: its unique_ptr adopts
+// `buffer`, which the cache owns and reuses via placement-new.
+CodeAnalysis analyze_into_impl(bytes_view code, uint8_t* buffer, size_t capacity)
+{
+    static constexpr auto PADDING = 32 + 1;
+    static constexpr auto BITSET_ALIGNMENT = alignof(BitsetSpan::word_type);
+
+    const auto padded_code_size = code.size() + PADDING;
+    const auto aligned_code_size =
+        (padded_code_size + (BITSET_ALIGNMENT - 1)) / BITSET_ALIGNMENT * BITSET_ALIGNMENT;
+    const auto bitset_words = (code.size() + (BitsetSpan::WORD_BITS)) / BitsetSpan::WORD_BITS;
+    const auto total_size = aligned_code_size + bitset_words * sizeof(BitsetSpan::word_type);
+
+    if (total_size > capacity)
+        __builtin_trap();  // can't happen: slots are sized to the fork's max analysis
+
+    uint8_t* storage = buffer;
+    std::ranges::copy(code, storage);                           // Copy code.
+    std::fill_n(&storage[code.size()], total_size - code.size(), 0);  // Pad + init bitset.
+
+    const auto bitset_storage =
+        new (&storage[aligned_code_size]) BitsetSpan::word_type[bitset_words];
+    const BitsetSpan jumpdest_bitset{bitset_storage};
+#if defined(ZEG_JUMPDEST_PRECOMPILE)
+    analyze_jumpdests(jumpdest_bitset, bytes_view{storage, code.size()});
+#else
+    analyze_jumpdests_sw(jumpdest_bitset, code);
+#endif
+    // Adopt `storage` without owning: the cache reuses the slot by placement-new
+    // and never destroys this object, so the unique_ptr's deleter never runs.
+    return {std::unique_ptr<uint8_t[]>(storage), code.size(), jumpdest_bitset};
+}
 }  // namespace
 
 CodeAnalysis analyze(bytes_view code)
 {
     return analyze_legacy(code);
 }
+
+CodeAnalysis analyze_into(bytes_view code, uint8_t* buffer, size_t capacity)
+{
+    return analyze_into_impl(code, buffer, capacity);
+}
 }  // namespace evmone::baseline
