+#if defined(ZEG_JUMPDEST_PRECOMPILE)
+void analyze_jumpdests(BitsetSpan map, bytes_view code) noexcept
+{
+    // ZisK: the walk above collapses into one jump_dest_bitmap op (CSR 0x81C),
+    // which writes ceil(size/64) words in the very layout BitsetSpan reads — same
+    // bits, same PUSH-data skipping — so check_jumpdest is unchanged.
+    if (code.empty())
+        return;  // no bitmap word to fill, and nothing to scan
+
+    // The precompile reads and writes whole aligned 64-bit words, so it is only
+    // provable when both pointers are 8-byte aligned. Here they are, by
+    // construction: `map` sits at an alignof(word_type) offset into the analysis
+    // buffer, and `code` is the padded copy rather than the caller's bytecode (see
+    // analyze_legacy). The check stays anyway — it costs two instructions against
+    // a whole-contract walk, and the alternative to catching a stray unaligned
+    // call here is an ELF that emulates fine and cannot be proven.
+    if (!zeg::evm::jump_dest_bitmap_usable(map.m_array, code.data(), code.size()))
+    {
+        analyze_jumpdests_sw(map, code);
+        return;
+    }
+
+    zeg::evm::jump_dest_bitmap(map.m_array, code.data(), code.size());
+}
