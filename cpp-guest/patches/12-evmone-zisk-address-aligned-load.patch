+#if defined(ZEG_ZISK)
+/// The evmc address at byte Offset of `owner`, as a big-endian uint256, read straight into
+/// registers. intx::be::load copies its 20 bytes (alignment 1) through a stack buffer and
+/// builds the result in another stack temporary; under -mtune=size GCC does the copy with
+/// 8-byte loads/stores that cross a ZisK memory word. Owner is 8-aligned, so the three
+/// 8-byte words covering the address are aligned loads: [0, 24) from it when it is 0 mod 8,
+/// [-4, 20) when it is 4 mod 8. The bytes around it belong to Owner, so reading them is
+/// reading Owner's own object representation.
+template <typename Owner, size_t Offset>
+inline uint256 zisk_load_address(const Owner& owner) noexcept
+{
+    constexpr size_t start = Offset & ~size_t{7};
+    static_assert(alignof(Owner) >= 8);
+    static_assert(Offset % 8 == 0 || Offset % 8 == 4);
+    static_assert(start + 24 <= sizeof(Owner));
+
+    const auto* const p = reinterpret_cast<const uint8_t*>(&owner) + start;
+    const auto word = [p](size_t i) noexcept {
+        uint64_t w;
+        std::memcpy(&w, __builtin_assume_aligned(p + 8 * i, 8), sizeof(w));
+        return __builtin_bswap64(w);  // the first byte is the most significant
+    };
+    const uint64_t w0 = word(0);
+    const uint64_t w1 = word(1);
+    const uint64_t w2 = word(2);
+    if constexpr (Offset % 8 == 0)
+        // The address is the first 20 of the 24 bytes.
+        return {(w1 << 32) | (w2 >> 32), (w0 << 32) | (w1 >> 32), w0 >> 32, 0};
+    else
+        // The address is the last 20 of the 24 bytes.
+        return {w2, w1, w0 & 0xffffffff, 0};
+}
+#endif
+
 inline void address(StackTop stack, ExecutionState& state) noexcept
 {
+#if defined(ZEG_ZISK)
+    stack.push(zisk_load_address<evmc_message, offsetof(evmc_message, recipient)>(*state.msg));
+#else
     stack.push(intx::be::load<uint256>(state.msg->recipient));
+#endif
 }
 
