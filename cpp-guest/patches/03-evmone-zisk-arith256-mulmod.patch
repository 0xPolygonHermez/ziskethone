+#if defined(ZEG_ZISK)
+    const auto& x = stack.pop();  // old top; slot stays readable
+    auto& y = stack.top();        // second item = result slot, distinct from x
+    uint64_t r[4];
+    zeg_arith::mul_low(&x[0], &y[0], r);
+    zeg_arith::store(y, r);
+#else
     stack.top() *= stack.pop();
+#endif
 }
 
