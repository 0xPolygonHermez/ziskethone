+#if defined(ZEG_ZISK)
+/// ZisK 256-bit multiply offload for MUL, EXP, ADDMOD and MULMOD, replacing
+/// intx's software bigint (~10^3 instructions per opcode) with one arith256 /
+/// arith256_mod precompile call. Mirrors src/zevm/instructions/arith.inl.hpp.
+/// intx::uint<256> is `uint64_t words_[4]` LE, so `&x[0]` needs no marshalling.
+///
+/// DIV/MOD/SDIV/SMOD stay on intx: the only 256-bit divider here is the
+/// bigint_div fcall, an unverified prover hint with no a == b*q + r check.
+namespace zeg_arith
+{
+constexpr uint64_t ZERO4[4]{};
+constexpr uint64_t ONE4[4]{1, 0, 0, 0};
+
+inline void copy4(uint64_t dst[4], const uint64_t src[4]) noexcept
+{
+    dst[0] = src[0];
+    dst[1] = src[1];
+    dst[2] = src[2];
+    dst[3] = src[3];
+}
+
+inline void store(uint256& dst, const uint64_t src[4]) noexcept
+{
+    dst[0] = src[0];
+    dst[1] = src[1];
+    dst[2] = src[2];
+    dst[3] = src[3];
+}
+
+/// Low 256 bits of a * b. The precompile must not alias output with input, so
+/// the 512-bit result lands in locals and only the low half is kept.
+inline void mul_low(const uint64_t a[4], const uint64_t b[4], uint64_t out[4]) noexcept
+{
+    uint64_t dl[4], dh[4];
+    zeg::bi::arith256(a, b, ZERO4, dl, dh);
+    copy4(out, dl);
+}
+}  // namespace zeg_arith
+#endif
