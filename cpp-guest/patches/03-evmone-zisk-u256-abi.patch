+#if defined(ZEG_ZISK)
+/// ZisK: the 256-bit multiply, modular and division opcodes go through the
+/// little-endian U256 ABI (zkvm_u256_le.h) instead of intx's software bigint. intx's
+/// uint<256> is `uint64_t words_[4]`, least significant first, which is exactly
+/// zkvm_u256_le, so the stack slots are passed as they are. The ABI follows EVM
+/// semantics (a zero divisor or modulus gives 0) and lets the result alias an input,
+/// so each opcode is one call that writes its stack slot in place.
+/// Mirrors src/zevm/instructions/arith.inl.hpp.
+namespace zeg_u256
+{
+inline const zkvm_u256_le* le(const uint256& x) noexcept
+{
+    return reinterpret_cast<const zkvm_u256_le*>(&x);
+}
+inline zkvm_u256_le* le(uint256& x) noexcept
+{
+    return reinterpret_cast<zkvm_u256_le*>(&x);
+}
+}  // namespace zeg_u256
+#endif
+
 namespace instr::core
 {
 
