 inline void mul(StackTop stack) noexcept
 {
+#if defined(ZEG_ZISK)
+    const auto& x = stack.pop();
+    auto& y = stack.top();
+    zkvm_u256_le_mul(zeg_u256::le(x), zeg_u256::le(y), zeg_u256::le(y));
+#else
     stack.top() *= stack.pop();
+#endif
 }
 
