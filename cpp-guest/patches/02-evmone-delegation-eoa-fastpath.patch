+// keccak256("") — the code_hash of any account with no deployed code (every
+// EOA and every account whose code was never set). Mirrors the constant
+// embedded in evmc and revm; kept local to avoid pulling a wider header.
+constexpr evmc::bytes32 EMPTY_CODE_HASH{{
+    0xc5, 0xd2, 0x46, 0x01, 0x86, 0xf7, 0x23, 0x3c,
+    0x92, 0x7e, 0x7d, 0xb2, 0xdc, 0xc7, 0x03, 0xc0,
+    0xe5, 0x00, 0xb6, 0x53, 0xca, 0x82, 0x27, 0x3b,
+    0x7b, 0xfa, 0xd8, 0x04, 0x5d, 0x85, 0xa4, 0x70,
+}};
+}  // namespace
+
