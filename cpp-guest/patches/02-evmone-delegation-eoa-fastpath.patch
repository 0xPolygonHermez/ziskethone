+    // can skip the (potentially expensive / witness-requiring) copy_code call
+    // entirely. The host's get_code_hash for an EOA or non-existent account
+    // returns keccak256("") (or zero, for hosts that distinguish "absent" from
+    // "empty"); both signal "no code, no delegation possible".
+    const auto code_hash = host.get_code_hash(addr);
+    if (code_hash == EMPTY_CODE_HASH || code_hash == evmc::bytes32{})
+        return {};
