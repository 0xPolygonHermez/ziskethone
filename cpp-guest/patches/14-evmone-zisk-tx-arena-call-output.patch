diff --git a/lib/evmone/execution_state.hpp b/lib/evmone/execution_state.hpp
--- a/lib/evmone/execution_state.hpp
+++ b/lib/evmone/execution_state.hpp
@@ -7,11 +7,16 @@
 #include <evmc/evmc.hpp>
 #include <intx/intx.hpp>
 #include <cassert>
+#include <cstring>
 #include <exception>
 #include <memory>
 #include <string>
 #include <vector>
 
+#if defined(ZEG_ZISK)
+extern "C" void* zeg_tx_arena_alloc(std::size_t size) noexcept;  // cpp-guest zisk/runtime.cpp
+#endif
+
 namespace evmone
 {
 namespace advanced
@@ -235,9 +240,28 @@
     const auto gas_refund = (state.status == EVMC_SUCCESS) ? state.gas_refund : 0;
 
     assert(state.output_size != 0 || state.output_offset == 0);
+#if defined(ZEG_ZISK)
+    // Output in the guest's per-transaction arena (cpp-guest
+    // include/zeg/tx_arena.hpp) instead of evmc_make_result's malloc. The
+    // guest's free() is a no-op, so the upstream per-call malloc leaked every
+    // frame's output: a 200M-gas block returning 1 KiB per CALL exhausted
+    // the heap. The caller copies the output (into return_data / memory, or
+    // Contracts for deployed code) and drops the result within the
+    // transaction; the arena is reset at the next one. No release function.
+    auto result = evmc::Result{state.status, gas_left, gas_refund, state.state_gas}.release_raw();
+    if (state.output_size != 0)
+    {
+        auto* const buf = static_cast<uint8_t*>(zeg_tx_arena_alloc(state.output_size));
+        std::memcpy(buf, &state.memory[state.output_offset], state.output_size);
+        result.output_data = buf;
+        result.output_size = state.output_size;
+    }
+    return result;
+#else
     return evmc::Result{state.status, gas_left, gas_refund,
         state.output_size != 0 ? &state.memory[state.output_offset] : nullptr, state.output_size,
         state.state_gas}
         .release_raw();
+#endif
 }
 }  // namespace evmone
