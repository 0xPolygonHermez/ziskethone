@@ -81,24 +81,68 @@ Result call_impl(StackTop stack, int64_t gas_left, ExecutionState& state) noexce
     stack.push(0);  // Assume failure.
     state.return_data.clear();
 
+    // (1) Charge CALL_VALUE_COST first — no state access yet. Mirrors revm's
+    // `gas!(interpreter, transfer_value_cost())` in load_acc_and_calc_gas, so
+    // a value-bearing CALL that's destined to OOG never queries the host for
+    // the target. Stateless hosts (reth's debug_executionWitness, ZK provers)
+    // never need to include addresses the EVM didn't materially read.
+    if constexpr (HAS_VALUE_ARG)
+    {
+        if constexpr (Op == OP_CALL)
+        {
+            if (has_value && state.in_static_mode())
+                return {EVMC_STATIC_MODE_VIOLATION, gas_left};
+        }
+        if (has_value)
+        {
+            if ((gas_left -= CALL_VALUE_COST) < 0)
+                return {EVMC_OUT_OF_GAS, gas_left};
+        }
+    }
+
+    // (2) Cold-access surcharge on dst.
     if (state.rev >= EVMC_BERLIN && state.host.access_account(dst) == EVMC_ACCESS_COLD)
     {
         if ((gas_left -= instr::additional_cold_account_access_cost) < 0)
             return {EVMC_OUT_OF_GAS, gas_left};
     }
 
-    const auto target_addr_or_result = get_target_address(dst, gas_left, state);
-    if (const auto* result = std::get_if<Result>(&target_addr_or_result))
-        return *result;
-
-    const auto& code_addr = std::get<evmc::address>(target_addr_or_result);
+    // (3) Account-creation cost — charged BEFORE the delegation probe, matching
+    // revm's ordering in load_account_delegated (is_empty check precedes the
+    // eip7702_address branch).
+    if constexpr (HAS_VALUE_ARG)
+    {
+        if constexpr (Op == OP_CALL)
+        {
+            if ((has_value || state.rev < EVMC_SPURIOUS_DRAGON)
+                && !state.host.account_exists(dst))
+            {
+                if ((gas_left -= ACCOUNT_CREATION_COST) < 0)
+                    return {EVMC_OUT_OF_GAS, gas_left};
+            }
+        }
+    }
 
+    // (4) Memory-expansion checks — pure arithmetic, no host access. Charged
+    // BEFORE the delegation probe so a CALL doomed to OOG on memory expansion
+    // never reads the callee's code (get_code_hash / copy_code). Mirrors revm:
+    // a stateless host (reth's debug_executionWitness, ZK provers) is never
+    // required to include bytecode the EVM didn't materially read. Without this
+    // the guest fatals on a valid block whose CALL OOGs on memory to a contract
+    // callee whose code the witness (correctly) omitted.
     if (!check_memory(gas_left, state.memory, input_offset_u256, input_size_u256))
         return {EVMC_OUT_OF_GAS, gas_left};
 
     if (!check_memory(gas_left, state.memory, output_offset_u256, output_size_u256))
         return {EVMC_OUT_OF_GAS, gas_left};
 
+    // (5) Delegation probe — only reached after ALL gas checks (incl. memory).
+    const auto target_addr_or_result = get_target_address(dst, gas_left, state);
+    if (const auto* result = std::get_if<Result>(&target_addr_or_result))
+        return *result;
+
+    const auto& code_addr = std::get<evmc::address>(target_addr_or_result);
+
     const auto input_offset = static_cast<size_t>(input_offset_u256);
     const auto input_size = static_cast<size_t>(input_size_u256);
     const auto output_offset = static_cast<size_t>(output_offset_u256);
@@ -124,23 +168,6 @@ Result call_impl(StackTop stack, int64_t gas_left, ExecutionState& state) noexce
         msg.input_size = input_size;
     }
 
